<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.cqels.playground</groupId>
    <artifactId>cqels-playground</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>CQELS Engine — Getting-Started Examples</name>
    <description>Runnable demonstration scenarios for the CQELS 2.0 continuous query engine.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Bump to the latest published CQELS release as new versions ship. -->
        <cqels.version>2.0.0-alpha.22</cqels.version>
        <!-- Default example for `mvn exec:java`; override with -Dexec.mainClass=... -->
        <exec.mainClass>org.cqels.playground.basics.HelloCqels</exec.mainClass>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- rdf4j-rio-jsonld 4.3.8 asks for jackson-core 2.13.5, which Maven would pick over the
                 engine's 2.18.12 (nearer in the tree) and so break jackson-databind 2.18.12. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.18.12</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The CQELS engine facade (pulls in cqels-core, windows, CEP, SPARQL/CqelsQL). -->
        <dependency>
            <groupId>org.cqels</groupId>
            <artifactId>cqels-engine</artifactId>
            <version>${cqels.version}</version>
        </dependency>

        <!-- Add-on modules used by the Reasoning & validation / Geospatial demos.
             Each is optional in your own project — depend only on what you use. -->
        <dependency>
            <groupId>org.cqels</groupId>
            <artifactId>cqels-reasoning-rete</artifactId>
            <version>${cqels.version}</version>
        </dependency>
        <dependency>
            <groupId>org.cqels</groupId>
            <artifactId>cqels-shacl</artifactId>
            <version>${cqels.version}</version>
        </dependency>
        <dependency>
            <groupId>org.cqels</groupId>
            <artifactId>cqels-asp</artifactId>
            <version>${cqels.version}</version>
        </dependency>
        <dependency>
            <groupId>org.cqels</groupId>
            <artifactId>cqels-geo</artifactId>
            <version>${cqels.version}</version>
        </dependency>
        <!-- Reference extension-function pack (Levenshtein, Haversine). Present on the
             classpath, its functions self-register via ServiceLoader and become callable
             from CQELS-QL by their IRI — see the ChargerRangeFilter demo. -->
        <dependency>
            <groupId>org.cqels</groupId>
            <artifactId>cqels-functions-ext</artifactId>
            <version>${cqels.version}</version>
        </dependency>

        <!-- A simple SLF4J binding so the engine's internal logs print to the console.
             Swap for logback/log4j in a real app; omit it and you'll just see an
             SLF4J "no providers" notice (the examples still run). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Tests for the RDF Message Log reader (org.cqels.playground.messages); same JUnit
             and surefire versions as sparql-endpoint. -->
        <!-- RDF Messages demo (org.cqels.playground.messages): the NDJSON-LD, YAML-LD and RDF/XML
             message logs. Same RDF4J version as the engine. snakeyaml-engine reads YAML 1.2 with
             its Core schema, so `yes` stays a string (Jackson's YAML reader makes it true).
             rdf4j-rio-jsonld excludes some httpcomponents artifacts that jsonld-java brought in
             (fluent-hc, httpmime, httpcore-nio and the OSGi bundles); nothing on the classpath
             uses them. -->
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-rio-jsonld</artifactId>
            <version>4.3.8</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-rio-rdfxml</artifactId>
            <version>4.3.8</version>
        </dependency>
        <dependency>
            <groupId>org.snakeyaml</groupId>
            <artifactId>snakeyaml-engine</artifactId>
            <version>2.10</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Served anonymously: no account, no token, no ~/.m2/settings.xml.
         GitHub Packages' Maven registry has no anonymous read even for public
         packages, so pointing here instead is what makes `mvn compile` work for
         someone who just cloned this repository. -->
    <repositories>
        <repository>
            <id>cqels</id>
            <name>CQELS Releases</name>
            <url>https://raw.githubusercontent.com/cqels/maven/main/releases</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <!-- pinned: Maven 3.8's default lifecycle bindings use 3.1, which predates maven.compiler.release
                     and fails with "Source option 5 is no longer supported" (cqels/CQELS4J#115) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Run an example with:
                 mvn -q compile exec:java -Dexec.mainClass=org.cqels.playground.basics.HelloCqels -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
